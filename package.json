{
  "name": "@cookbook/urlkit",
  "version": "2.0.1",
  "description": "Framework-agnostic typed URL contract library for parsing, validating, normalizing, matching, and building URL state.",
  "license": "MIT",
  "author": "The Cookbook",
  "homepage": "https://github.com/the-cookbook/urlkit#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/the-cookbook/urlkit.git"
  },
  "bugs": {
    "url": "https://github.com/the-cookbook/urlkit/issues"
  },
  "keywords": [
    "url",
    "url-state",
    "typed-url",
    "type-safe-url",
    "url-parser",
    "url-builder",
    "url-routing",
    "typed-routes",
    "typed-search-params",
    "search-params",
    "path-params",
    "hash-fragments",
    "query-string",
    "request-parsing",
    "schema",
    "validation",
    "normalization",
    "routing",
    "router",
    "typescript",
    "framework-agnostic",
    "edge-runtime",
    "browser",
    "nodejs",
    "nextjs",
    "react-router",
    "remix",
    "hono",
    "express",
    "fastify"
  ],
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@9.15.4",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./static": {
      "types": "./dist/static.d.ts",
      "import": "./dist/static.js"
    },
    "./router-runtime": {
      "types": "./dist/router-runtime.d.ts",
      "import": "./dist/router-runtime.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prepack": "npm run build",
    "prepare": "husky",
    "clean": "rm -rf dist coverage",
    "build": "pnpm run clean && rollup -c && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-package": "changeset version",
    "release": "pnpm run typecheck && pnpm test && pnpm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "21.0.2",
    "@commitlint/config-conventional": "21.0.2",
    "@eslint/js": "10.0.1",
    "@rollup/plugin-typescript": "^12.3.0",
    "eslint": "10.4.1",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "17.0.7",
    "prettier": "3.8.3",
    "rollup": "^4.61.1",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.60.1",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@cookbook/pathkit": "^0.4.0"
  }
}
